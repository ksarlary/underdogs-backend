subscription_id = "00000000-0000-0000-0000-000000000000"
environment     = "prod"

# France Centre n'ouvre pas la série B à tous les abonnements, et West Europe ne
# l'ouvre qu'en zone 1. Vérifier avant de changer :
#   az vm list-skus --location <region> --resource-type virtualMachines -o table
location          = "westeurope"
vm_size           = "Standard_B2s_v2"
availability_zone = "1"

# Doit être unique dans la région : le FQDN sera
# <dns_label>-prod.westeurope.cloudapp.azure.com
dns_label = "underdogs-esport"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Remplacer par son IP publique pour ne pas exposer SSH au monde entier.
ssh_source_address = "*"
