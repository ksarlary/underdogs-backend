# FQDN renvoyé par `terraform output site_address`, sans schéma.
SITE_ADDRESS=underdogs-esport-prod.francecentral.cloudapp.azure.com

# Images publiées par les pipelines CD des trois dépôts.
BACKEND_IMAGE=ghcr.io/ksarlary/underdogs-api:latest
FRONTEND_IMAGE=ghcr.io/ksarlary/underdogs-frontend:latest
WORKER_IMAGE=ghcr.io/4l0cks/underdogs-worker:latest

# Base métier
DB_NAME=underdogs
DB_USERNAME=underdogs
DB_PASSWORD=CHANGE_ME

# Base Keycloak
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# Compte d'amorçage de la console d'administration Keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
